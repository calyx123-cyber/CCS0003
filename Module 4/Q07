#include <iostream>
#include <iomanip>
#include <cmath>
using namespace std;

int main() {
    double x1, y1, x2, y2;

   cout << "Starting point (x1 y1): ";
cin >> x1 >> y1;

cout << "Target point (x2 y2): ";
cin >> x2 >> y2;

    double dx = x2 - x1;
    double dy = y2 - y1;
    double distance = sqrt(pow(dx, 2) + pow(dy, 2));
    int roundedDistance = static_cast<int>(round(distance));

    cout << fixed << setprecision(3);
    cout << "dx: " << dx << '\n';
    cout << "dy: " << dy << '\n';
    cout << "Distance: " << distance << '\n';
    cout << "Rounded distance: " << roundedDistance << '\n';

    return 0;
}
